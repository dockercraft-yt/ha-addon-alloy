      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"haos-journal\", container=~\"$container\"} |~ \"WARNING\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
